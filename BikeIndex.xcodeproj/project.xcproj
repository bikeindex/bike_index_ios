        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": "@executable_path/../Frameworks",
        "MACOSX_DEPLOYMENT_TARGET": "14.4",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER[config=Debug]": "match Development org.bikeindex.app",
        "PROVISIONING_PROFILE_SPECIFIER[config=Release]": "match AppStore org.bikeindex.app",
