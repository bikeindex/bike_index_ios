      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/BikeIndex.app", "id": "04F4B8F72B098ADB009442B5", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/UnitTests.xctest", "id": "04F4B90A2B098ADE009442B5", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/UITests.xctest", "id": "04F4B9142B098ADE009442B5", "type": "wrapper.cfbundle", "index": false },
