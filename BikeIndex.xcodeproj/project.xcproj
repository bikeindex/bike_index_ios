      "repository": "https://github.com/getsentry/SnapshotPreviews/",
      "version": {
        "up-to-next-major-version": "0.20.0",
      },
    },
  ],
  "files": [
    { "path": "README.md", "encoding": "utf8" },
    { "path": "BikeIndex-development.xcconfig", "encoding": "utf8" },
    { "path": "BikeIndex-production.xcconfig", "encoding": "utf8" },
