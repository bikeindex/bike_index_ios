    }, {
      "kind": "folder",
      "path": "SharedTests",
      "membership-exceptions": [
        {
          "target": "UnitTests",
          "inclusions": [
            "Logger+Tests.swift",
          ],
        }, {
          "target": "UITests",
          "inclusions": [
            "Logger+Tests.swift",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "UITests",
