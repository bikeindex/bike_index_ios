        { "path": "Appfile" },
        { "path": "Fastfile" },
        { "path": "README.md" },
        { "path": "Gymfile" },
        { "path": "Matchfile" },
        { "path": "Scanfile" },
        { "kind": "group", "path": "metadata" },
