        "UITests",
      ],
      "membership-exceptions": [
        {
          "target": "UITests",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "UnitTests", "target-membership": [ "UnitTests" ] },
    { "path": "Brewfile", "type": "text.script.ruby" },
