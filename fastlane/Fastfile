# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

# Ensure an available simulator with an exact name match exists so xcodebuild
# never falls back to `simctl clone` (which fails on CI when the template
# device references a runtime bundle missing from the runner image).
ensure_simulator = lambda do |device|
  raise "ensure_simulator requires a device" if device.to_s.empty?

  sh("xcrun simctl delete unavailable")

  if sh("xcrun simctl list devices available").include?("  #{device} (")
    UI.message("Using existing simulator: #{device}")
    return true
  end

  runtimes = JSON.parse(sh("xcrun simctl list runtimes --json"))["runtimes"]
  ios = runtimes.select do |r|
    r["name"].to_s.start_with?("iOS") && r["isAvailable"] &&
      Array(r["supportedDeviceTypes"]).any? { |t| t["name"] == device }
  end
  ios.sort_by! { |r| r["version"].split(".").map(&:to_i) }.reverse!
  raise "ensure_simulator: no installed iOS runtime supports '#{device}'" if ios.empty?

  runtime = ios.first
  device_type = Array(runtime["supportedDeviceTypes"]).find { |t| t["name"] == device }
  sh("xcrun simctl create '#{device}' '#{device_type["identifier"]}'")
  UI.message("Created simulator: #{device} on #{runtime["name"]}")
end

# Lane invocations pass --device through parameters; `fastlane scan --device=...`
# does not (it's a Scan CLI option). CI prunes unavailable simulators in the
# workflow before calling scan, so this hook covers lane-based invocations.
before_all do |_lane, parameters|
  device = parameters[:device]
  ensure_simulator.call(device) if device
end

platform :ios do
  # ------ Continuous Integration ------

  desc "Run test suite on iPhone 18 Pro"
  lane :tests_iphone18pro do
    ensure_simulator.call("iPhone 18 Pro")
    # See Scanfile for default configuration
    scan(
      devices: ["iPhone 18 Pro"],
      deployment_target_version: "27.0"
    )
  end

  desc "Run test suite on iPhone 17"
  lane :tests_iphone17 do
    ensure_simulator.call("iPhone 17")
    # See Scanfile for default configuration
    scan(
      devices: ["iPhone 17"],
      deployment_target_version: "27.0"
    )
  end

  desc "Run test suite on iPad (A16)"
  lane :tests_ipad do
    ensure_simulator.call("iPad (A16)")
    # See Scanfile for default configuration
    scan(
      devices: ["iPad (A16)"],
      deployment_target_version: "27.0"
    )
  end

  desc "Run test suite (all default simulators)"
  lane :tests do
    scan()
  end

  # ------ Continuous Delivery ------

  desc "Set up keychain access and codesigning"
  lane :CD_setup_keychain_and_codesigning do
    keychain = "bikeindex_keychain"
    keychain_password = "bikeindex_keychain_password_2026"

    if is_ci
      # Caution: take care with the default_keychain parameter
      create_keychain(
        default_keychain: true,
        name: keychain,
        password: keychain_password,
        unlock: true,
        timeout: "3600",
        lock_when_sleeps: false
      )

      match(
        type: "appstore",
        readonly: true,
        keychain_name: keychain,
        keychain_password: keychain_password,
      )
    else
      puts "Failed to run CD_setup_keychain, is_ci value is false. Please set up keychain with fastlane run create_keychain"
    end
  end


  desc "Perform all tasks to make a new release: increment build, archive, upload"
  lane :CD_build_release_archive do
    current_build_number = latest_testflight_build_number(
      # Only available for CI/CD after "Load API key" step
      api_key_path: "./fastlane/api-key.json"
    )

    increment_build_number({
      build_number: current_build_number + 1,
    })

    gym()

    deliver(
      # Only available for CI/CD after "Load API key" step
      api_key_path: "./fastlane/api-key.json",
      skip_metadata: true
    )
  end
end
