# For more information about this configuration visit
# https://docs.fastlane.tools/actions/scan/#scanfile

# In general, you can use the options available
# fastlane scan --help

project("BikeIndex.xcodeproj")
scheme("BikeIndex")
testplan("AllTests")

# Scanfile contains defaults and these can be overridden by Fastfile
# or CLI arguments
deployment_target_version = "27.0"

disable_concurrent_testing(true)
result_bundle(true)
reset_simulator(true)
force_quit_simulator(true)
include_simulator_logs(false)

# Use xcbeautify (NOT the default xcpretty) as the xcodebuild formatter. This
# makes scan write test_output/report.junit from the xcresult (trainer) instead
# of from xcpretty. xcpretty's JUnit omits Swift Testing tests entirely, so the
# CI retry (scripts/failed-test-configurations.rb) would never see their
# failures; the xcresult-based report includes both XCTest and Swift Testing
# tests (and scan's pass/fail is read from the xcresult either way). xcbeautify
# is installed via the Brewfile in every job that runs `fastlane scan`
# (see .github/workflows/integration.yml).
xcodebuild_formatter("xcbeautify")

# Retries are configured in AllTests.xctestplan

# Output Fastlane build prodcuts in a local directory
# for GitHub Actions to cache and re-use
derived_data_path("build/")
